<% if @entry.errors.any? %>
  <div style="color:red" >
    <h2><%= pluralize(@entry.error.count, "error") %> prevented saving:</h2>
    <ul>
      <% @entry.errors.full_messages.each do |m| %>
      <li><%= m %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: [@user, @entry], local: true) do |f| %>
  <div>
    <%= f.label :date %> 
    <%= f.date_field :date %>
  </div>
  <div>
    <%= f.label :notes %> 
    <%= f.text_area :notes %>
  </div>
  <%= f.submit %>
<% end %>
