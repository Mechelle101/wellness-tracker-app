<% if @nutrition_log.errors.any? %>
  <div style="color:red">
    <h2><%= pluralize(@nutrition_log.errors.count, "error") %> prevented saving:</h2>
    <ul>
      <% @nutrition_log.errors.full_messages.each do |m| %>
        <li><%= m %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: [@entry, @nutrition_log], local: true) do |f| %>
  <div>
    <%= f.label :meal_type %> 
    <%= f.text_field :meal_type %>
  </div>
  <div>
    <%= f.label :food_type %> 
    <%= f.text_field :food_type %>
  </div>
  <div>
    <%= f.label :calories %> 
    <%= f.number_field :calories, step: 1 %>
  </div>
  <div>
    <%= f.label :protein_g %> 
    <%= f.number_field :protein_g, step: 0.1 %>
  </div>
  <div>
    <%= f.label :carbs_g %> 
    <%= f.number_field :carbs_g, step: 0.1 %>
  </div>
  <div>
    <%= f.label :fats_g %> 
    <%= f.number_field :fats_g, step: 0.1 %>
  </div>
  <div>
    <%= f.label :notes %> 
    <%= f.text_area :notes %>
  </div>
  <%= f.submit %>
<% end %>
