<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wellness Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# PWA manifest (optional) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Simple top bar -->
    <header style="display:flex; gap:1rem; align-items:center; justify-content:space-between; padding:.75rem 1rem; border-bottom:1px solid 
      3eee;">
        <nav style="display:flex; gap:.75rem;">
          <%= link_to "Dashboard", dashboard_path %>
          <%= link_to "Entries", entries_path %>
        </nav>

        <div>
        <% if current_user %>
          <span>Signed in as <strong><%= current_user.full_name.presence || current_user.email %></strong></span>
            &middot;
          <%= button_to "Sign Out", session_path, method: :delete, form: { style: "display:inline" } %>
        <% else %>
          <%= link_to "Sign In", new_session_path %> &middot; <%= link_to "Sign up", new_user_path %>
        <% end %>
      </div>
    </header>

    <!-- Flash message -->
    <section aria-live="polite" style="max-width:900px; margin:0 auto; padding:1rem;">
      <% flash.each do |type, message| %>
        <p class="flash <%= type %>" style="margin:0 0 .75em; padding:.5rem .75rem; border-radius:.375rem;
            <%= type.to_s == "notice" ? 'background:#e8f5e9; color:#1b5e20;' : 'background:#ffebee; color:#b71c1c;' %>">
          <%= message %>
        </p>
      <% end %>
    </section>

    <main style="max-width:900px; margin:0 auto; padding:0 1rem 2rem;">
      <%= yield %>
    </main>
  </body>
</html>
