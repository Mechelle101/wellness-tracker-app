<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wellness Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# PWA manifest (optional) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body">
    <!-- Simple top bar -->
    <header class="app-header">
      <nav class="app-nav">
        <%= link_to "Dashboard", dashboard_path, class: "app-nav-link" %>
        <%= link_to "Entries",   entries_path,   class: "app-nav-link" %>
      </nav>

      <h2 class="app-title">Wellness Tracker</h2>

      <div class="app-auth">
        <% if current_user %>
          <span class="app-user">
            Signed in as
            <strong><%= current_user.full_name.presence || current_user.email %></strong>
          </span>
          &middot;
          <%= button_to "Sign Out",
                        session_path,
                        method: :delete,
                        form:  { class: "inline-form" },
                        class: "btn btn-secondary" %>
        <% else %>
          <%= link_to "Sign In", new_session_path, class: "app-nav-link" %> &middot;
          <%= link_to "Sign up", new_user_path,    class: "app-nav-link" %>
        <% end %>
      </div>
    </header>

    <!-- Flash message -->
    <section class="flash-region" aria-live="polite">
      <% flash.each do |type, message| %>
        <p class="flash-message flash-<%= type %>">
          <%= message %>
        </p>
      <% end %>
    </section>

    <main class="app-main">
      <%= yield %>
    </main>
  </body>
</html>